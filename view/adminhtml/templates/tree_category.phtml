$postData = $block->getCategoryIds();

/**
 * Recursively render the category checkbox tree.
 *
 * @param int $id
 * @param string $postData
 * @return void
 */
// phpcs:ignore Squiz.Functions.GlobalFunction.Found
function categoryLoop($id, $postData)
{
    $postCatArray = explode(',', $postData);

    // phpcs:ignore Magento2.Templates.ObjectManager.ObjectManagerUsageFound
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();

    $categories = $objectManager->create(\Magento\Catalog\Model\Category::class)->load($id);

    if ($categories->hasChildren()) { ?>
        <ul>
        <?php
        $subcategories = explode(',', $categories->getChildren());
        foreach ($subcategories as $category) {
            $subcategory = $objectManager->create(\Magento\Catalog\Model\Category::class)->load($category); ?>
            <li>
            <div class="category-item">
            <span class="checkbox-input">
            <input
                type='checkbox'
                class='category-checkbox'
                value="<?= $escaper->escapeHtmlAttr($category) ?>"
                <?php if (in_array($category, $postCatArray)) {
                    echo 'checked';
                } ?>
            /></span>

            <span class="cat-name">
            <?= $escaper->escapeHtml($subcategory->getName()) ?>
            </span>
            </div>
            </li>
            <?php if ($subcategory->hasChildren()) {
                echo "<li>";
                categoryLoop($category, $postData);
                echo "</li>";
            }
        } ?>
        </ul>
    <?php }
}

categoryLoop(2, $postData);
