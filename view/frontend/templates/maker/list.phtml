<script type="text/javascript">
require(['jquery'], function ($) {
    $(".makers ul li").click(function(){
        var id = $(this).attr("class"); 
        var ids = $(this).attr("id"); 
        if(ids != "disable"){
            if(id == "All"){
                $(".makers ul li").each(function(){
                    $(this).removeClass("active");
                });
                $(this).addClass("active");
                $(".ict-shopbybrand-makers-list-container div").each(function(){
                    $(this).addClass("active");
                });
            } else {
                $(".makers ul li").each(function(){
                    $(this).removeClass("active");
                });
                $(this).addClass("active");
                $(".ict-shopbybrand-makers-list-container div").each(function(){
                    $(this).removeClass("active");
                });
                $(".ict-shopbybrand-makers-list-container div."+id+"").each(function(){
                    $(this).addClass("active");
                });
            }
        }
    });

    $("#maker-form").on("submit", function(e){
        e.preventDefault();
        var searchVal = $("#maker-search").val().toLowerCase().trim();
        $(".makers ul li").removeClass("active");
        if(searchVal == ""){
            $(".makers ul li.All").addClass("active");
            $(".ict-shopbybrand-maker-list-item").addClass("active");
        } else {
            $(".makers ul li.All").addClass("active");
            $(".ict-shopbybrand-maker-list-item").each(function(){
                var name = $(this).find("span").text().toLowerCase();
                if(name.indexOf(searchVal) !== -1){
                    $(this).addClass("active");
                } else {
                    $(this).removeClass("active");
                }
            });
        }
    });

    $(".search-input.active").on("click", function(e){
        e.preventDefault();
        $("#maker-form").trigger("submit");
    });
});
</script>